# URL da API FastAPI (desenvolvimento).
# No próprio PC: http://127.0.0.1:8000
# Celular/tablet na mesma rede Wi‑Fi: use o IP LAN deste computador, ex.:
#   VITE_API_URL=http://192.168.0.15:8000
# (no Windows: ipconfig → endereço IPv4.) Reinicie o Vite após alterar.
VITE_API_URL=http://127.0.0.1:8000
